# Copy to .env only for manual configuration. No default credential is accepted.
DATABASE_URL=sqlite:///./governance.db
# Server-side accounts contain SHA256 token hashes, user, tenant, role.
DEMO_ACCOUNTS_JSON=[]
# live fails closed without configured providers; fixture is a deterministic local test dependency.
PROVIDER_MODE=live
# presidio requires en_core_web_sm installed; regex is a limited explicitly selected demo fallback.
PII_MODE=presidio
AZURE_OPENAI_ENDPOINT=''
AZURE_OPENAI_DEPLOYMENT=''
AZURE_OPENAI_API_VERSION='v1'
AZURE_OPENAI_API_KEY=''
OPENAI_API_KEY=''
PROVIDER_TIMEOUT=20
ADLS_ACCOUNT_URL=
ADLS_FILE_SYSTEM=
CORS_ORIGIN=http://localhost:5173
AZURE_SQL_TENANT_ID=
AZURE_SQL_USER_OBJECT_ID=

# Azure SQL is opt-in: keep DATABASE_URL above as SQLite until integration is approved.
# Future URL: mssql+pyodbc://@<server>.database.windows.net/<database>?driver=ODBC+Driver+18+for+SQL+Server
# These are directory identifiers, not passwords or access tokens.

# Restricted demo sessions; provisioned credentials remain an operator-only compatibility path.
DEMO_SESSION_MINUTES=60
# Durable SQL-backed limits include governance inspections that can call moderation.
INFERENCE_USER_PER_MINUTE=30
INFERENCE_TENANT_PER_MINUTE=100
INFERENCE_DAILY_QUOTA=500
INFERENCE_CONCURRENCY=4
INFERENCE_DEADLINE=90
INFERENCE_WARNING_PERCENT=80
# Default export/analytics window is 90 days; explicit windows are at most 366 days.
EXPORT_MAX_RECORDS=10000
EXPORT_MAX_BYTES=5000000
EXPORT_MAX_ATTEMPTS=3
EXPORT_LEASE_SECONDS=180
# A declared retention target only; never automatically deletes historical records.
RETENTION_DAYS=365
BUILD_VERSION=working-tree

# Operator compatibility only. Browser credentials are exchanged for expiring sessions.
ALLOW_LEGACY_API_CREDENTIALS=false
DATABASE_QUERY_TIMEOUT=15

# Shared SQL write-heavy operation limits per actor per minute.
SESSION_PER_MINUTE=10
EXPORT_PER_MINUTE=10

# Compatibility bridge: preserve approved demo login; enable SSO only after SQL 005 acceptance.
SSO_ENABLED=false
DEMO_BROWSER_LOGIN_ENABLED=true
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Server-only confidential-client credential; never put in a frontend VITE_ setting.
ENTRA_CLIENT_SECRET=
# Exact HTTPS origin, without trailing slash; callback is /api/sso/callback.
SSO_PUBLIC_ORIGIN=
SSO_SESSION_MINUTES=120

# Protected Human Review prompts (opt-in; operator-applied local revision 007 after 006).
# Never place real keys in this file. Supply an independent 32-byte base64 AES key
# through the runtime environment; JSON maps versioned key IDs to base64 keys.
REVIEW_CAPTURE_ENABLED=false
REVIEW_CLEANUP_ENABLED=false
REVIEW_CONTENT_ACTIVE_KEY_ID=
REVIEW_CONTENT_KEYS_JSON={}
# When rolling capture back, keep REVIEW_CLEANUP_ENABLED=true until all held
# ciphertext expires or is resolved. Physical cleanup depends on app/DB availability.

# Enable only after separate bounded live-provider verification approval. GET Settings never calls providers.
INTEGRATION_VERIFICATION_ENABLED=false
INTEGRATION_VERIFICATION_FRESHNESS_HOURS=24
