# Copy to .env only for manual configuration. No default credential is accepted.
DATABASE_URL=sqlite:///./governance.db
# Server-side accounts contain SHA256 token hashes, user, tenant, role.
DEMO_ACCOUNTS_JSON=[]
# live fails closed without configured providers; fixture is a deterministic local test dependency.
PROVIDER_MODE=live
# presidio requires en_core_web_sm installed; regex is a limited explicitly selected demo fallback.
PII_MODE=presidio
AZURE_OPENAI_ENDPOINT=''
AZURE_OPENAI_DEPLOYMENT=''
AZURE_OPENAI_API_VERSION='v1'
AZURE_OPENAI_API_KEY=''
OPENAI_API_KEY=''
PROVIDER_TIMEOUT=20
ADLS_ACCOUNT_URL=
ADLS_FILE_SYSTEM=
CORS_ORIGIN=http://localhost:5173
AZURE_SQL_TENANT_ID=
AZURE_SQL_USER_OBJECT_ID=

# Azure SQL is opt-in: keep DATABASE_URL above as SQLite until integration is approved.
# Future URL: mssql+pyodbc://@<server>.database.windows.net/<database>?driver=ODBC+Driver+18+for+SQL+Server
# These are directory identifiers, not passwords or access tokens.
